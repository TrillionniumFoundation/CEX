{
  "$id": "https://trillionnium.example/schemas/paper-raid/artifact-bundle-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_root": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-manifest-v1"
        },
        "digest_file": {
          "const": "artifact-bundle.v1.sha256"
        }
      },
      "required": [
        "algorithm",
        "digest_file"
      ],
      "type": "object"
    },
    "bundle_id": {
      "minLength": 1,
      "type": "string"
    },
    "challenge_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "hepta_binding_status": {
      "const": "unbound"
    },
    "human_authority_materialized": {
      "const": false
    },
    "object_count": {
      "minimum": 1,
      "type": "integer"
    },
    "objects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_json": {
            "type": "boolean"
          },
          "dependencies": {
            "items": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "logical_path": {
            "minLength": 1,
            "type": "string"
          },
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "canonical_json",
          "dependencies",
          "logical_path",
          "media_type",
          "role",
          "sha256",
          "size"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "required_run_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "paper-raid.artifact-bundle.v1"
    }
  },
  "required": [
    "artifact_root",
    "bundle_id",
    "challenge_id",
    "created_at",
    "hepta_binding_status",
    "human_authority_materialized",
    "object_count",
    "objects",
    "required_run_ids",
    "schema"
  ],
  "title": "Neutral Paper Raid artifact bundle manifest",
  "type": "object"
}
