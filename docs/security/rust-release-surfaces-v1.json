{
  "coverage_strategy": "all_workspace_packages_are_release_candidates",
  "external_repository_execution": {
    "unbound_explicit_checkout": "forbidden",
    "workflows": {
      ".github/workflows/world-settlement-external-evidence.yml": {
        "checkouts": [
          {
            "allowed_packages": [
              "trnm-economy-service"
            ],
            "path": "cex-owner",
            "ref": "${{ steps.lock.outputs.cex_commit }}",
            "repository": "${{ steps.lock.outputs.cex_repository }}"
          },
          {
            "allowed_packages": [
              "trnm-game-server"
            ],
            "path": "world",
            "ref": "${{ steps.lock.outputs.world_commit }}",
            "repository": "${{ steps.lock.outputs.world_repository }}"
          }
        ]
      }
    }
  },
  "invariants": [
    "every root-workspace package is checked as a possible release candidate",
    "every reachable local path package is recursively parsed",
    "every tracked disconnected Cargo package is rejected",
    "all inverse and forward Cargo graph commands must exit zero",
    "normal and build edges are checked across all targets",
    "nested Dockerfiles, Containerfiles, Compose, systemd, workflows, build tools, deployment trees, and neutral release scripts are scanned",
    "unknown explicit local package, binary, manifest, git, wildcard, or repository-external path references fail",
    "external repository package commands require an exact pinned checkout action, credential persistence disabled, a literal descendant working-directory, exact repository/ref step-output bindings, and a closed package allowlist"
  ],
  "maximum_text_scan_bytes": 8388608,
  "production_authorization": "not_granted",
  "schema": "cex.rust-release-surfaces.v1",
  "surface_detection": {
    "content_markers": [
      "/opt/cex/bin/",
      "ExecStart=",
      "cargo build",
      "cargo install",
      "cargo publish",
      "docker build",
      "docker buildx build",
      "gh release",
      "helm install",
      "helm package",
      "helm upgrade",
      "kubectl apply",
      "podman build",
      "target/release/"
    ],
    "path_globs": [
      "**/*.mk",
      "**/Containerfile",
      "**/Containerfile.*",
      "**/Dockerfile",
      "**/Dockerfile.*",
      "**/GNUmakefile",
      "**/Justfile",
      "**/Makefile",
      "**/compose*.yaml",
      "**/compose*.yml",
      "**/docker-compose*.yaml",
      "**/docker-compose*.yml",
      "**/justfile",
      "**/makefile",
      ".github/workflows/*.yaml",
      ".github/workflows/*.yml",
      "Containerfile",
      "Containerfile.*",
      "Dockerfile",
      "Dockerfile.*",
      "GNUmakefile",
      "Justfile",
      "Makefile",
      "charts/**",
      "deploy/**",
      "helm/**",
      "justfile",
      "k8s/**",
      "kubernetes/**",
      "makefile",
      "ops/**",
      "scripts/**"
    ]
  },
  "unknown_explicit_package_references": "forbidden",
  "unreachable_local_package_manifests": "forbidden"
}
