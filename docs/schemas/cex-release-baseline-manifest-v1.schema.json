    "schema": {
      "const": "cex.release-baseline-manifest.v1"
    },
    "status": {
      "enum": [
        "draft",
        "candidate"
      ]
    },
    "project_id": {
      "const": "hepta-control-plane"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "qualification_scope": {
      "const": "repository-exact-money-control-plane-plus-hepta-durability-doc-integrity-full-suite-lint-receipt-recovery-and-trnm-production-config-hardening"
    },
    "production_ready": {
      "const": false
    },
    "production_authorization": {
      "const": "not_granted"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit_sha",
        "tree_sha"
      ],
      "properties": {
        "repository": {
          "const": "TrillionniumFoundation/CEX"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*//)(?!.*\\.\\.)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*@\\{)(?!refs/)(?!HEAD$)(?!.*/$)[A-Za-z0-9._/-]+$"
        },
        "commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "tree_sha": {
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo_lock_sha256"
      ],
      "properties": {
        "cargo_lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_head",
        "migration_sha256",
        "migration_chain_sha256"
      ],
      "properties": {
        "migration_head": {
          "const": "0088_enforce_provider_terminal_evidence_binding.sql"
        },
        "migration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "migration_chain_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_run_id",
        "artifacts",
        "images",
        "sbom",
        "provenance"
      ],
      "properties": {
        "workflow_run_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestedArtifact"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "sbom": {
          "anyOf": [
            {
              "$ref": "#/$defs/digestedArtifact"
            },
