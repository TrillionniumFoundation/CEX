  "$id": "https://trillionnium.example/schemas/cex-release-baseline-manifest-v1.schema.json",
  "title": "CEX Release Baseline Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "project_id",
    "release_id",
    "generated_at",
    "qualification_scope",
    "production_ready",
    "production_authorization",
    "source",
    "dependencies",
    "database",
    "build",
    "evidence",
    "approvals",
    "external_gates",
    "revocation"
