# App
RUST_LOG=info
APP_ENV=dev

# Gateway binding
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Service URLs
LEDGER_BASE_URL=http://127.0.0.1:7002
EXECUTION_BASE_URL=http://127.0.0.1:7003
IDENTITY_BASE_URL=http://127.0.0.1:7001
AUDIT_BASE_URL=http://127.0.0.1:7004

# Split admin principals for detached local runtime exercises
# Identity/key-management token can issue/revoke API keys.
# Identity/read-only token can list API keys without full manage scope.
# These two identity principals are additionally constrained to the seeded local-dev org via org_ids.
IDENTITY_ADMIN_TOKENS_JSON=[{"token":"identity-manage-token","actor_id":"identity-admin","actor_label":"Identity Admin","scopes":["api_keys:manage"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]},{"token":"identity-read-token","actor_id":"identity-reader","actor_label":"Identity Reader","scopes":["api_keys:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]

# Audit-read token: can read /v1/audit/events/trace/:trace_id, but cannot manage API keys.
# It is also constrained to the seeded local-dev org via org_ids.
AUDIT_ADMIN_TOKENS_JSON=[{"token":"audit-read-token","actor_id":"audit-reader","actor_label":"Audit Reader","scopes":["audit:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]

# Execution admin tokens: one write token for lifecycle transitions, optionally one narrower read token.
# Both are constrained to the seeded local-dev org via org_ids.
EXECUTION_ADMIN_TOKENS_JSON=[{"token":"execution-manage-token","actor_id":"execution-admin","actor_label":"Execution Admin","scopes":["executions:manage"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]},{"token":"execution-read-token","actor_id":"execution-reader","actor_label":"Execution Reader","scopes":["executions:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]

# Ledger admin tokens: one write token for direct account/credit mutations, optionally one narrower read token.
# Both are constrained to the seeded local-dev org via org_ids.
LEDGER_ADMIN_TOKENS_JSON=[{"token":"ledger-manage-token","actor_id":"ledger-admin","actor_label":"Ledger Admin","scopes":["ledger:manage"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]},{"token":"ledger-read-token","actor_id":"ledger-reader","actor_label":"Ledger Reader","scopes":["ledger:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]

# Leave the legacy single-token fallback unset during split-token exercises.
# IDENTITY_ADMIN_TOKEN=
# AUDIT_ADMIN_TOKEN=
# EXECUTION_ADMIN_TOKEN=
# LEDGER_ADMIN_TOKEN=

# Ledger behavior
LEDGER_FAIL_FAST=false

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cex_ai

# Redis
REDIS_URL=redis://127.0.0.1:6379

# NATS
NATS_URL=nats://127.0.0.1:4222
