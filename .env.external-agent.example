# Local development example for the external-Agent-only Capability Service.
# This file is not a production secret source or activation record.

CEX_RUNTIME_PROFILE=dev
CAPABILITY_BIND_ADDR=127.0.0.1:7005

# Single quotes preserve the JSON bytes when this file is sourced by a shell.
# Public declarations only: never put private keys, credentials or research here.
CAPABILITY_EXTERNAL_AGENT_REGISTRY_JSON='[{"capability_id":"cap.external-agent.paper-analysis.v1","kind":"external_agent_capability","provider":"external-agent","provider_ref":"did:trnm:agent-example#paper-analysis-v1","display_name":"External paper analysis Agent","version":"hepta_agent_protocol_v1","description":"Public capability declaration only; execution and signing remain external.","enabled":true}]'

# The legacy local-provider opt-in is intentionally absent; never enable it here.
