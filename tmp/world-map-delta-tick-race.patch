+fn route_runner_epoch_from_cursor(cursor: Option<&str>) -> Option<i64> {
+    let cursor = cursor?;
+    let base = cursor
+        .split_once(";gv=")
+        .map_or(cursor, |(base, _)| base);
+    base.split(';')
+        .find_map(|component| component.strip_prefix("r="))
+        .and_then(|value| value.parse::<i64>().ok())
+        .filter(|value| *value >= 0)
+}
+
+fn route_runner_delta_epoch_for_now(cursor: Option<&str>, now_epoch: i64) -> i64 {
+    let current_tick = route_runner_tick_epoch(now_epoch);
+    let Some(previous_tick) = route_runner_epoch_from_cursor(cursor) else {
+        return current_tick;
+    };
+    let previous_is_immediately_adjacent =
+        current_tick.saturating_sub(previous_tick)
+            == TRILLIONNIUM_ROUTE_RUNNER_PROJECTION_TICK_SECONDS;
+    let boundary_age = now_epoch.saturating_sub(current_tick);
+    if previous_is_immediately_adjacent
+        && (0..TRILLIONNIUM_ROUTE_RUNNER_CURSOR_GRACE_SECONDS).contains(&boundary_age)
+    {
+        previous_tick
+    } else {
+        current_tick
+    }
 }
 
