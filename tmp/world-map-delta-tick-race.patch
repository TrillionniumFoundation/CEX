+#[cfg(test)]
+mod route_runner_cursor_tests {
+    use super::*;
+
+    #[test]
+    fn cursor_epoch_parser_is_bounded_to_the_runner_component() {
+        assert_eq!(
+            route_runner_epoch_from_cursor(Some(
+                "region=core;tile=t;z=15;e=1;r=90;m=2;a=1;gv=avatar_route_runners:abc"
+            )),
+            Some(90)
+        );
+        assert_eq!(route_runner_epoch_from_cursor(Some("region=core;gv=r=105")), None);
+        assert_eq!(route_runner_epoch_from_cursor(Some("region=core;r=-1;gv=x:y")), None);
+        assert_eq!(route_runner_epoch_from_cursor(Some("region=core;r=bad;gv=x:y")), None);
+    }
+
+    #[test]
+    fn adjacent_tick_uses_a_short_boundary_grace_only() {
+        let cursor = Some("region=core;r=90;gv=avatar_route_runners:abc");
+        assert_eq!(route_runner_delta_epoch_for_now(cursor, 105), 90);
+        assert_eq!(route_runner_delta_epoch_for_now(cursor, 106), 90);
+        assert_eq!(route_runner_delta_epoch_for_now(cursor, 107), 105);
+        assert_eq!(route_runner_delta_epoch_for_now(cursor, 120), 120);
+        assert_eq!(route_runner_delta_epoch_for_now(None, 106), 105);
+    }
+}
