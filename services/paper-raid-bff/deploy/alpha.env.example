# Container listener. The host must publish this only to 127.0.0.1 and expose
# it remotely through an authenticated SSH tunnel.
PAPER_RAID_BFF_BIND=0.0.0.0:7020
PAPER_RAID_BFF_EDGE_SCOPE=container_loopback_publish
PAPER_RAID_BFF_PUBLIC_ORIGIN=http://127.0.0.1:7020

PAPER_RAID_BFF_DATABASE_URL=postgres://paper_raid_bff:change-me@postgres/paper_raid_bff
PAPER_RAID_BFF_SESSION_KEY_B64=replace-with-canonical-base64-of-32-random-bytes

PAPER_RAID_BFF_ALPHA_IDENTITIES_JSON=[{"login_key":"replace-with-at-least-32-random-bytes","subject_id":"alpha-subject-1","display_name":"Player One","nakama_user_id":"00000000-0000-0000-0000-000000000001","player_id":"00000000-0000-0000-0000-000000000011"},{"login_key":"replace-with-at-least-32-random-bytes-2","subject_id":"alpha-subject-2","display_name":"Player Two","nakama_user_id":"00000000-0000-0000-0000-000000000002","player_id":"00000000-0000-0000-0000-000000000012"},{"login_key":"replace-with-at-least-32-random-bytes-3","subject_id":"alpha-subject-3","display_name":"Player Three","nakama_user_id":"00000000-0000-0000-0000-000000000003","player_id":"00000000-0000-0000-0000-000000000013"}]

PAPER_RAID_BFF_HEPTA_BASE_URL=http://hepta-research-league:7011
PAPER_RAID_BFF_CONSUMER_ISSUER=consumer-edge-alpha
PAPER_RAID_BFF_HEPTA_AUDIENCE=hepta-research-league
PAPER_RAID_BFF_CONSUMER_KEY_ID=consumer-edge-alpha-key-1
PAPER_RAID_BFF_CONSUMER_SIGNING_SEED_B64=replace-with-canonical-base64-of-32-random-bytes

PAPER_RAID_BFF_NAKAMA_BASE_URL=http://nakama:7350
PAPER_RAID_BFF_NAKAMA_HTTP_KEY=replace-with-deployment-client-server-key

PAPER_RAID_BFF_CAS_ENDPOINT=http://minio:9000
PAPER_RAID_BFF_CAS_BUCKET=paper-raid-alpha
PAPER_RAID_BFF_CAS_REGION=us-east-1
PAPER_RAID_BFF_CAS_ACCESS_KEY_ID=replace-with-append-scoped-access-key
PAPER_RAID_BFF_CAS_SECRET_ACCESS_KEY=replace-with-append-scoped-secret-key
PAPER_RAID_BFF_CAS_READY_DIGEST=sha256:replace-with-the-64-lowercase-hex-digest-of-a-deployment-canary
PAPER_RAID_BFF_CAS_READY_MEDIA_TYPE=application/json
