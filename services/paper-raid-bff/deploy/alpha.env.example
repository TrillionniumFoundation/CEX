# Container listener. The host must publish this only to 127.0.0.1 and expose
# it remotely through an authenticated SSH tunnel.
PAPER_RAID_BFF_BIND=0.0.0.0:7020
PAPER_RAID_BFF_EDGE_SCOPE=container_loopback_publish
PAPER_RAID_BFF_PUBLIC_ORIGIN=http://127.0.0.1:7020

PAPER_RAID_BFF_DATABASE_URL=postgres://paper_raid_bff:change-me@postgres/paper_raid_bff
PAPER_RAID_BFF_SESSION_KEY_B64=replace-with-canonical-base64-of-32-random-bytes

PAPER_RAID_BFF_IDENTITY_MODE=fixed_alpha
PAPER_RAID_BFF_ALPHA_IDENTITIES_JSON=[{"login_key":"replace-author-captain-login-key-0001","subject_id":"alpha-author-captain","display_name":"Author Captain","nakama_user_id":"00000000-0000-0000-0000-000000000001","player_id":"00000000-0000-0000-0000-000000000011","scopes":["author"],"author_roles":["captain"]},{"login_key":"replace-author-evidence-login-key-0002","subject_id":"alpha-author-evidence","display_name":"Author Evidence","nakama_user_id":"00000000-0000-0000-0000-000000000002","player_id":"00000000-0000-0000-0000-000000000012","scopes":["author"],"author_roles":["evidence"]},{"login_key":"replace-author-experiment-login-key-003","subject_id":"alpha-author-experiment","display_name":"Author Experiment","nakama_user_id":"00000000-0000-0000-0000-000000000003","player_id":"00000000-0000-0000-0000-000000000013","scopes":["author"],"author_roles":["experiment"]},{"login_key":"replace-independent-evaluator-key-0004","subject_id":"alpha-evaluator","display_name":"Independent Evaluator","nakama_user_id":"00000000-0000-0000-0000-000000000004","player_id":"00000000-0000-0000-0000-000000000014","scopes":["evaluator"],"author_roles":[]},{"login_key":"replace-independent-reviewer-key-00005","subject_id":"alpha-reviewer-1","display_name":"Independent Reviewer One","nakama_user_id":"00000000-0000-0000-0000-000000000005","player_id":"00000000-0000-0000-0000-000000000015","scopes":["reviewer"],"author_roles":[]},{"login_key":"replace-independent-reviewer-key-00006","subject_id":"alpha-reviewer-2","display_name":"Independent Reviewer Two","nakama_user_id":"00000000-0000-0000-0000-000000000006","player_id":"00000000-0000-0000-0000-000000000016","scopes":["reviewer"],"author_roles":[]},{"login_key":"replace-independent-reproducer-key-007","subject_id":"alpha-reproducer","display_name":"Independent Reproducer","nakama_user_id":"00000000-0000-0000-0000-000000000007","player_id":"00000000-0000-0000-0000-000000000017","scopes":["reproducer"],"author_roles":[]}]

# Invite-Key SSH Alpha is an explicit alternative identity authority. To use
# it, set identity mode to invite_alpha, DELETE the fixed identities variable
# above, and explicitly configure every value below. No default retention
# duration or quota is inferred.
# PAPER_RAID_BFF_ACCESS_RETENTION_POLICY_ID=operator-approved-policy-id
# PAPER_RAID_BFF_LOGIN_QUOTA_WINDOW_SECONDS=replace-explicitly
# PAPER_RAID_BFF_LOGIN_QUOTA_GLOBAL_LIMIT=replace-explicitly
# PAPER_RAID_BFF_LOGIN_QUOTA_BUCKET_LIMIT=replace-explicitly
# PAPER_RAID_BFF_MUTATION_QUOTA_WINDOW_SECONDS=replace-explicitly
# PAPER_RAID_BFF_MUTATION_QUOTA_ACCOUNT_LIMIT=replace-explicitly

# Agent Bridge v2 uses durable global, fixed 256-bucket and valid-binding
# windows in both identity modes. Pairing codes live for five minutes and are
# stored only as SHA-256 digests.
PAPER_RAID_BFF_AGENT_BRIDGE_QUOTA_WINDOW_SECONDS=60
PAPER_RAID_BFF_AGENT_PAIR_QUOTA_GLOBAL_LIMIT=120
PAPER_RAID_BFF_AGENT_PAIR_QUOTA_BUCKET_LIMIT=8
PAPER_RAID_BFF_AGENT_REQUEST_QUOTA_GLOBAL_LIMIT=2000
PAPER_RAID_BFF_AGENT_REQUEST_QUOTA_BUCKET_LIMIT=120
PAPER_RAID_BFF_AGENT_REQUEST_QUOTA_BINDING_LIMIT=240

PAPER_RAID_BFF_HEPTA_BASE_URL=http://hepta-research-league:7011
PAPER_RAID_BFF_CONSUMER_ISSUER=consumer-edge-alpha
PAPER_RAID_BFF_HEPTA_AUDIENCE=hepta-research-league
PAPER_RAID_BFF_CONSUMER_KEY_ID=consumer-edge-alpha-key-1
PAPER_RAID_BFF_CONSUMER_SIGNING_SEED_B64=replace-with-canonical-base64-of-32-random-bytes

PAPER_RAID_BFF_NAKAMA_BASE_URL=http://nakama:7350
PAPER_RAID_BFF_NAKAMA_HTTP_KEY=replace-with-deployment-client-server-key

PAPER_RAID_BFF_CAS_ENDPOINT=http://minio:9000
PAPER_RAID_BFF_CAS_BUCKET=paper-raid-alpha
PAPER_RAID_BFF_CAS_REGION=us-east-1
PAPER_RAID_BFF_CAS_ACCESS_KEY_ID=replace-with-append-scoped-access-key
PAPER_RAID_BFF_CAS_SECRET_ACCESS_KEY=replace-with-append-scoped-secret-key
PAPER_RAID_BFF_CAS_READY_DIGEST=sha256:replace-with-the-64-lowercase-hex-digest-of-a-deployment-canary
PAPER_RAID_BFF_CAS_READY_MEDIA_TYPE=application/json
