# TRNM CEX settlement service example.
# Apply migrations through the controlled migration workflow in production.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cex_ai
TRNM_CEX_SETTLEMENT_HOST=127.0.0.1
TRNM_CEX_SETTLEMENT_PORT=7010
TRNM_CEX_SETTLEMENT_APPLY_MIGRATIONS=0

# Store only SHA-256 digests of game-authority credentials.
# Replace the placeholder with 64 lowercase hexadecimal characters.
TRNM_GAME_AUTHORITY_PRINCIPALS_JSON=[{"authority_id":"trnm-world-legacy-local-alpha","audience":"trnm-cex-settlement-v1","token_sha256":"<sha256>","active":true}]

# The public key is standard base64 for exactly 32 Ed25519 bytes. The
# fingerprint is SHA-256 of those decoded bytes.
TRNM_ENTITLEMENT_ISSUER_KEYS_JSON=[{"key_id":"<key-id>","issuer":"trnm-online-game-server","status":"active","signature_algorithm":"ed25519","public_key_base64":"<base64>","public_key_sha256":"<sha256>"}]
