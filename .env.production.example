# CEX production-posture environment example.
# Copy to a secret-managed runtime environment; do not commit real values.

APP_ENV=production
CEX_RUNTIME_PROFILE=production
RUST_LOG=info

# Bindings / service URLs
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
LEDGER_BASE_URL=http://127.0.0.1:7002
EXECUTION_BASE_URL=http://127.0.0.1:7003
IDENTITY_BASE_URL=http://127.0.0.1:7001
AUDIT_BASE_URL=http://127.0.0.1:7004
CAPABILITY_BASE_URL=http://127.0.0.1:7005

# Database / infra
DATABASE_URL=postgres://cex:REPLACE_ME@postgres.internal:5432/cex_ai
REDIS_URL=redis://redis.internal:6379
NATS_URL=nats://nats.internal:4222

# Repo-local or mounted OpenClaw scope for CEX provider bridge.
OPENCLAW_STATE_DIR=/var/lib/cex/openclaw
OPENCLAW_CONFIG_PATH=/var/lib/cex/openclaw/openclaw.json
OPENCLAW_AGENT_DIR=/var/lib/cex/openclaw/agents/cex/agent
CAPABILITY_OPENCLAW_MODELS_JSON_PATH=/var/lib/cex/openclaw/agents/cex/agent/models.json
CEX_PROVIDER_PROBE_MODEL=google/gemini-2.5-flash
CEX_PROVIDER_PROBE_TIMEOUT_SECONDS=180

# Product API key presented by product-entry services to gateway.
# Must correspond to a real active identity-service API key; local-dev-key is rejected by readiness production mode.
CEX_GATEWAY_API_KEY=REPLACE_WITH_ACTIVE_PRODUCT_API_KEY

# Split admin principals. Keep tokens high entropy and scope/org limited.
IDENTITY_ADMIN_TOKENS_JSON=[{"token":"REPLACE_IDENTITY_MANAGE_TOKEN","actor_id":"identity-admin","actor_label":"Identity Admin","scopes":["api_keys:manage","api_keys:read"]}]
AUDIT_ADMIN_TOKENS_JSON=[{"token":"REPLACE_AUDIT_READ_TOKEN","actor_id":"audit-reader","actor_label":"Audit Reader","scopes":["audit:read"]}]
EXECUTION_ADMIN_TOKENS_JSON=[{"token":"REPLACE_EXECUTION_MANAGE_TOKEN","actor_id":"execution-admin","actor_label":"Execution Admin","scopes":["executions:manage","executions:read"]}]
LEDGER_ADMIN_TOKENS_JSON=[{"token":"REPLACE_LEDGER_MANAGE_TOKEN","actor_id":"ledger-admin","actor_label":"Ledger Admin","scopes":["ledger:manage","ledger:read"]}]
EXECUTION_ADMIN_TOKEN=REPLACE_EXECUTION_MANAGE_TOKEN
EXECUTION_WORKER_ADMIN_TOKEN=REPLACE_EXECUTION_MANAGE_TOKEN

# Execution policy bundle. Env-specific POLICY_* vars still override the bundle for emergency changes.
EXECUTION_POLICY_BUNDLE_PATH=/etc/cex/execution-policy.json
# Known non-launch provider prefixes must be blocked while their account/billing state is unresolved.
CEX_REQUIRED_BLOCK_CAPABILITY_PREFIXES=cap.openclaw.model.minimax.,cap.openclaw.model.openai-codex.

# Gateway / execution worker hardening
CEX_ENABLE_QUEUED_WORKER=1
EXECUTION_WORKER_ID=cex-prod-worker-1
EXECUTION_CLAIM_LEASE_SECONDS=300
EXECUTION_PROVIDER_DISPATCH_TIMEOUT_SECONDS=60
EXECUTION_QUEUED_WORKER_MAX_ATTEMPTS=3
EXECUTION_RETRY_BACKOFF_SECONDS=5
EXECUTION_RETRY_BACKOFF_MAX_SECONDS=60

# Product-edge ingress protection
CONSUMER_ENTRY_INGRESS_TOKEN=REPLACE_CONSUMER_ENTRY_INGRESS_TOKEN
MATRIX_ENTRY_INGRESS_TOKEN=REPLACE_MATRIX_ENTRY_INGRESS_TOKEN
MATRIX_BOT_USER_ID=@cex-prod-bot:your-homeserver.example
CONSUMER_ENTRY_REQUIRE_SESSION_AUTH=true
CONSUMER_ENTRY_REQUIRE_IDENTITY_BINDING=true

# Durable product-edge replay/dedupe/rate-limit state.
CONSUMER_ENTRY_REPLAY_STORE_PATH=/var/lib/cex/edge/consumer-entry-replay.json
CONSUMER_ENTRY_RATE_LIMIT_STORE_PATH=/var/lib/cex/edge/consumer-entry-rate-limit.json
MATRIX_ENTRY_RECENT_EVENT_STORE_PATH=/var/lib/cex/edge/matrix-entry-recent-events.json

# Identity binding / product-user registry governance.
CONSUMER_ENTRY_IDENTITY_BINDINGS_PATH=/etc/cex/identity-bindings.json
CONSUMER_ENTRY_IDENTITY_REGISTRY_PATH=/etc/cex/identity-registry.json
CONSUMER_ENTRY_IDENTITY_BINDING_AUDIT_LOG_PATH=/var/log/cex/identity-binding-audit.jsonl
CONSUMER_ENTRY_IDENTITY_BINDING_APPROVED_REVISIONS_PATH=/etc/cex/identity-binding-approved-revisions.json
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REQUIRE_REVISION=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REJECT_SAME_REVISION=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REQUIRE_APPROVED_REVISION=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_ALLOW_ROLLBACK=false
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REQUIRE_ACTOR=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_ALLOWED_ACTORS=cex-ops

# Session-auth issuer registry shared between matrix-entry-adapter and consumer-entry-api.
CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_PATH=/etc/cex/session-auth-issuer-registry.json
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_PATH=/etc/cex/session-auth-issuer-registry.json
CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_APPROVED_REVISIONS_PATH=/etc/cex/session-auth-issuer-registry-approved-revisions.json
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_APPROVED_REVISIONS_PATH=/etc/cex/session-auth-issuer-registry-approved-revisions.json
CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_REQUIRE_APPROVED_REVISION=true
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_REQUIRE_APPROVED_REVISION=true
CONSUMER_ENTRY_SESSION_AUTH_ALLOWED_ISSUERS=matrix-entry-adapter
CONSUMER_ENTRY_SESSION_AUTH_EXPECTED_AUDIENCE=consumer-entry-api
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER=matrix-entry-adapter
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_AUDIENCE=consumer-entry-api
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_TTL_SECS=300

# Readiness / soak signoff.
CEX_READINESS_MODE=production
CEX_DB_BACKUP_RESTORE_DRILL_REQUIRED=1
CEX_DB_BACKUP_RESTORE_DRILL_MAX_AGE_SECONDS=86400
# Optionally pin to a known summary instead of the newest run/drills/db-backup-restore-*.summary.json.
# CEX_DB_BACKUP_RESTORE_DRILL_SUMMARY_PATH=/var/lib/cex/readiness/db-backup-restore.summary.json
CEX_MONITORING_DEPLOY_VERIFY_REQUIRED=1
CEX_MONITORING_DEPLOY_METADATA_PATH=/var/lib/cex/monitoring/metadata/monitoring-deploy-metadata.yml
CEX_MONITORING_DEPLOY_MAX_AGE_SECONDS=86400
CEX_SOAK_DURATION_SECONDS=3600
CEX_SOAK_INTERVAL_SECONDS=60
