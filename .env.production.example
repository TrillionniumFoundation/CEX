# CEX production-posture environment example.
# Copy to a secret-managed runtime environment; do not commit real values.

APP_ENV=production
CEX_RUNTIME_PROFILE=production
RUST_LOG=info

# Startup guard / fail-closed posture.
CEX_STARTUP_DATABASE_TIMEOUT_SECONDS=5
GATEWAY_FAIL_FAST=true
IDENTITY_FAIL_FAST=true
LEDGER_FAIL_FAST=true
EXECUTION_FAIL_FAST=true
AUDIT_FAIL_FAST=true

# Ledger exact-authority controls. Production-like startup rejects malformed
# values and refuses to disable explicit trace or player-session ownership.
LEDGER_V2_REQUIRE_EXPLICIT_TRACE=true
TRNM_REQUIRE_PLAYER_SESSION=true
TRNM_ALLOW_SYSTEM_ECONOMY_OPERATIONS=false

# Internal workload identity v1. Replace each value with a distinct high-entropy token.
CEX_INTERNAL_SERVICE_AUTH_MODE=enforce
CEX_INTERNAL_SERVICE_TOKENS_JSON={"gateway-service":"REPLACE_GATEWAY_INTERNAL_SERVICE_TOKEN","identity-service":"REPLACE_IDENTITY_INTERNAL_SERVICE_TOKEN","execution-service":"REPLACE_EXECUTION_INTERNAL_SERVICE_TOKEN","audit-outbox-dispatcher":"REPLACE_AUDIT_OUTBOX_DISPATCHER_TOKEN"}

# Durable saga rollout. Shadow mode records modeled commands but never dispatches them.
CEX_SAGA_SHADOW_WRITE=1

# Canonical Gateway rejects the legacy reserve_amount: f64 path.
CEX_GATEWAY_LEGACY_RESERVE_BREAK_GLASS=false

# Audit outbox dispatcher. Request timeout must remain shorter than the claim lease.
CEX_AUDIT_OUTBOX_WORKER_ID=cex-audit-outbox-prod-1
CEX_AUDIT_OUTBOX_BATCH_SIZE=25
CEX_AUDIT_OUTBOX_LEASE_SECONDS=60
CEX_AUDIT_OUTBOX_POLL_SECONDS=2
CEX_AUDIT_OUTBOX_REQUEST_TIMEOUT_SECONDS=20
CEX_AUDIT_OUTBOX_MAX_RESPONSE_BYTES=262144
CEX_AUDIT_OUTBOX_RUN_ONCE=0

# Bindings / service URLs
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
LEDGER_BASE_URL=http://127.0.0.1:7002
EXECUTION_BASE_URL=http://127.0.0.1:7003
IDENTITY_BASE_URL=http://127.0.0.1:7001
AUDIT_BASE_URL=http://127.0.0.1:7004
CAPABILITY_BASE_URL=http://127.0.0.1:7005

# Database / infra
DATABASE_URL=postgres://cex:REPLACE_ME@postgres.internal:5432/cex_ai
REDIS_URL=redis://redis.internal:6379
NATS_URL=nats://nats.internal:4222

# ADR-004 external-Agent-only capability snapshot. CEX does not discover local
# models, execute OpenClaw/Ollama, host inference or receive Agent private keys.
# Replace the illustrative declaration with a reviewed, versioned external registry.
CAPABILITY_EXTERNAL_AGENT_REGISTRY_JSON=[{"capability_id":"cap.external-agent.REPLACE_ME","kind":"external_agent_capability","provider":"external-agent","provider_ref":"did:trnm:REPLACE_AGENT#capability","display_name":"REPLACE reviewed external Agent capability","version":"hepta_agent_protocol_v1","description":"Reviewed public declaration only; no credential or execution authority.","enabled":true}]

# Product API key presented by product-entry services to gateway.
CEX_GATEWAY_API_KEY=REPLACE_WITH_DISTINCT_ACTIVE_PRODUCT_API_KEY

# TRNM economy production lane. Every credential below must be pairwise
# distinct, high entropy, and delivered by the runtime secret manager.
LEDGER_ADMIN_TOKEN=REPLACE_WITH_DISTINCT_LEDGER_ADMIN_TOKEN
TRNM_VALUE_ENTITLEMENT_SIGNING_SECRET=REPLACE_WITH_DISTINCT_ENTITLEMENT_SIGNING_SECRET
TRNM_ENTITLEMENT_ISSUER_REGISTRY_PATH=/etc/cex/trnm-entitlement-issuer-registry.json
TRNM_GAME_AUTHORITY_TOKEN=REPLACE_WITH_DISTINCT_GAME_AUTHORITY_TOKEN
TRNM_PLAYER_SESSION_SIGNING_SECRET=REPLACE_WITH_DISTINCT_PLAYER_SESSION_SIGNING_SECRET
CONSUMER_ENTRY_INGRESS_TOKEN=REPLACE_WITH_DISTINCT_CONSUMER_ENTRY_INGRESS_TOKEN
CONSUMER_ENTRY_SESSION_AUTH_SECRET=REPLACE_WITH_DISTINCT_CONSUMER_SESSION_AUTH_SECRET
CONSUMER_ENTRY_LEAGUE_WEB_SESSION_SECRET=REPLACE_WITH_DISTINCT_LEAGUE_WEB_SESSION_SECRET

# Split admin principals. Keep tokens high entropy and scope/org limited.
IDENTITY_ADMIN_TOKENS_JSON=[{"token":"REPLACE_IDENTITY_MANAGE_TOKEN","actor_id":"identity-admin","actor_label":"Identity Admin","scopes":["api_keys:manage","api_keys:read"]}]
AUDIT_ADMIN_TOKENS_JSON=[{"token":"REPLACE_AUDIT_READ_TOKEN","actor_id":"audit-reader","actor_label":"Audit Reader","scopes":["audit:read"]}]
EXECUTION_ADMIN_TOKENS_JSON=[{"token":"REPLACE_EXECUTION_MANAGE_TOKEN","actor_id":"execution-admin","actor_label":"Execution Admin","scopes":["executions:manage","executions:read"]}]
LEDGER_ADMIN_TOKENS_JSON=[{"token":"REPLACE_LEDGER_MANAGE_TOKEN","actor_id":"ledger-admin","actor_label":"Ledger Admin","scopes":["ledger:manage","ledger:read"]}]
EXECUTION_ADMIN_TOKEN=REPLACE_EXECUTION_MANAGE_TOKEN
EXECUTION_WORKER_ADMIN_TOKEN=REPLACE_EXECUTION_MANAGE_TOKEN

# Execution policy and exact settlement worker. Do not set
# CEX_ENABLE_LEGACY_LOCAL_PROVIDER_DISPATCH and do not launch the feature-gated
# execution-provider-dispatch-worker in a production-like profile.
EXECUTION_POLICY_BUNDLE_PATH=/etc/cex/execution-policy.json
EXECUTION_SETTLEMENT_WORKER_ID=cex-settlement-prod-1
EXECUTION_SETTLEMENT_CLAIM_LEASE_SECONDS=300
EXECUTION_SETTLEMENT_POLL_SECONDS=2
EXECUTION_SETTLEMENT_REQUEST_TIMEOUT_SECONDS=60

# Product-edge ingress protection
MATRIX_ENTRY_INGRESS_TOKEN=REPLACE_MATRIX_ENTRY_INGRESS_TOKEN
MATRIX_BOT_USER_ID=@cex-prod-bot:your-homeserver.example
CONSUMER_ENTRY_REQUIRE_SESSION_AUTH=true
CONSUMER_ENTRY_REQUIRE_IDENTITY_BINDING=true

# Durable Matrix transport. Use separate runtime logins inheriting only the
# poller, relay and reconciler capability roles installed by reviewed migrations.
MATRIX_TRANSPORT_DATABASE_URL=postgresql://matrix_relay:REPLACE_ME@postgres.internal:5432/cex_ai
MATRIX_RELAY_WORKER_ID=cex-matrix-relay-prod-1
MATRIX_RELAY_INGRESS_TOKEN=REPLACE_MATRIX_RELAY_INGRESS_TOKEN
MATRIX_ENTRY_ADAPTER_TOKEN=REPLACE_MATRIX_ADAPTER_TOKEN
MATRIX_ADAPTER_BASE_URL=https://matrix-adapter.internal
MATRIX_HOMESERVER_BASE_URL=https://matrix.example
MATRIX_ACCESS_TOKEN=REPLACE_MATRIX_HOMESERVER_ACCESS_TOKEN
MATRIX_RELAY_CLAIM_LEASE_SECONDS=60
MATRIX_RELAY_HTTP_TIMEOUT_SECONDS=20
MATRIX_RELAY_DELIVERY_MAX_ATTEMPTS=8

# One-delivery adapter result reconciliation. The dedicated login must inherit
# only cex_matrix_reconciler_runtime. The command reads both secrets from the
# environment and never places them in process arguments.
MATRIX_ENTRY_ADAPTER_BASE_URL=https://matrix-adapter.internal
MATRIX_RECONCILIATION_DATABASE_URL=postgresql://matrix_reconciler:REPLACE_ME@postgres.internal:5432/cex_ai

# Durable product-edge replay/dedupe/rate-limit state.
CONSUMER_ENTRY_REPLAY_STORE_PATH=/var/lib/cex/edge/consumer-entry-replay.json
CONSUMER_ENTRY_RATE_LIMIT_STORE_PATH=/var/lib/cex/edge/consumer-entry-rate-limit.json
MATRIX_ENTRY_RECENT_EVENT_STORE_PATH=/var/lib/cex/edge/matrix-entry-recent-events.json

# Identity binding / product-user registry governance.
CONSUMER_ENTRY_IDENTITY_BINDINGS_PATH=/etc/cex/identity-bindings.json
CONSUMER_ENTRY_IDENTITY_REGISTRY_PATH=/etc/cex/identity-registry.json
CONSUMER_ENTRY_IDENTITY_BINDING_AUDIT_LOG_PATH=/var/log/cex/identity-binding-audit.jsonl
CONSUMER_ENTRY_IDENTITY_BINDING_APPROVED_REVISIONS_PATH=/etc/cex/identity-binding-approved-revisions.json
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REQUIRE_REVISION=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REJECT_SAME_REVISION=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REQUIRE_APPROVED_REVISION=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_ALLOW_ROLLBACK=false
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_REQUIRE_ACTOR=true
CONSUMER_ENTRY_IDENTITY_BINDING_RELOAD_ALLOWED_ACTORS=cex-ops

# Session-auth issuer registry shared between matrix-entry-adapter and consumer-entry-api.
CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_PATH=/etc/cex/session-auth-issuer-registry.json
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_PATH=/etc/cex/session-auth-issuer-registry.json
CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_APPROVED_REVISIONS_PATH=/etc/cex/session-auth-issuer-registry-approved-revisions.json
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_APPROVED_REVISIONS_PATH=/etc/cex/session-auth-issuer-registry-approved-revisions.json
CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_REQUIRE_APPROVED_REVISION=true
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_REQUIRE_APPROVED_REVISION=true
CONSUMER_ENTRY_SESSION_AUTH_ALLOWED_ISSUERS=matrix-entry-adapter
CONSUMER_ENTRY_SESSION_AUTH_EXPECTED_AUDIENCE=consumer-entry-api
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER=matrix-entry-adapter
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_AUDIENCE=consumer-entry-api
MATRIX_ENTRY_CONSUMER_SESSION_AUTH_TTL_SECS=300

# Readiness / soak signoff.
CEX_READINESS_MODE=production
CEX_DB_BACKUP_RESTORE_DRILL_REQUIRED=1
CEX_DB_BACKUP_RESTORE_DRILL_MAX_AGE_SECONDS=86400
# CEX_DB_BACKUP_RESTORE_DRILL_SUMMARY_PATH=/var/lib/cex/readiness/db-backup-restore.summary.json
CEX_MONITORING_DEPLOY_VERIFY_REQUIRED=1
CEX_MONITORING_DEPLOY_METADATA_PATH=/var/lib/cex/monitoring/metadata/monitoring-deploy-metadata.yml
CEX_MONITORING_DEPLOY_MAX_AGE_SECONDS=86400
CEX_SOAK_DURATION_SECONDS=3600
CEX_SOAK_INTERVAL_SECONDS=60
