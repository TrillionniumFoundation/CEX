# App
RUST_LOG=info
APP_ENV=dev
CEX_RUNTIME_PROFILE=local_dev

# Gateway binding
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Legacy reserve_amount: f64 is fail-closed on the canonical route. Set this
# only for an explicitly reviewed non-production rollback test.
CEX_GATEWAY_LEGACY_RESERVE_BREAK_GLASS=false

# Service URLs
LEDGER_BASE_URL=http://127.0.0.1:7002
EXECUTION_BASE_URL=http://127.0.0.1:7003
IDENTITY_BASE_URL=http://127.0.0.1:7001
AUDIT_BASE_URL=http://127.0.0.1:7004
CAPABILITY_BASE_URL=http://127.0.0.1:7005

# ADR-004 external-Agent-only capability declarations. This metadata does not
# authorize execution and must never contain Agent private keys or provider tokens.
CAPABILITY_EXTERNAL_AGENT_REGISTRY_JSON=[{"capability_id":"cap.external-agent.local-example","kind":"external_agent_capability","provider":"external-agent","provider_ref":"agent:local-example","display_name":"External Agent local example","version":"hepta_agent_protocol_v1","description":"Local public declaration only; participating Agent runs outside CEX.","enabled":true}]

# Execution owns lifecycle/evidence correlation and exact Ledger settlement only.
# Do not enable legacy-local-provider-dispatch or launch the feature-gated legacy
# provider worker. Participating Agents remain separate external processes.
EXECUTION_CLAIM_LEASE_SECONDS=300
EXECUTION_DEFAULT_MAX_ATTEMPTS=1
EXECUTION_RETRY_BACKOFF_SECONDS=5
EXECUTION_RETRY_BACKOFF_MAX_SECONDS=60

# Identity/audit/execution/ledger admin
# Shared-token compatibility shape:
# IDENTITY_ADMIN_TOKENS_JSON=[{"token":"local-dev-admin-token","actor_id":"local-dev-admin","actor_label":"Local Dev Admin","scopes":["api_keys:manage","audit:read","executions:manage","executions:read","ledger:manage","ledger:read"]}]
# Fully split shape with optional org_ids:
# IDENTITY_ADMIN_TOKENS_JSON=[{"token":"identity-manage-token","actor_id":"identity-admin","actor_label":"Identity Admin","scopes":["api_keys:manage"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]},{"token":"identity-read-token","actor_id":"identity-reader","actor_label":"Identity Reader","scopes":["api_keys:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]
# AUDIT_ADMIN_TOKENS_JSON=[{"token":"audit-read-token","actor_id":"audit-reader","actor_label":"Audit Reader","scopes":["audit:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]
# EXECUTION_ADMIN_TOKENS_JSON=[{"token":"execution-manage-token","actor_id":"execution-admin","actor_label":"Execution Admin","scopes":["executions:manage"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]},{"token":"execution-read-token","actor_id":"execution-reader","actor_label":"Execution Reader","scopes":["executions:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]
# LEDGER_ADMIN_TOKENS_JSON=[{"token":"ledger-manage-token","actor_id":"ledger-admin","actor_label":"Ledger Admin","scopes":["ledger:manage"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]},{"token":"ledger-read-token","actor_id":"ledger-reader","actor_label":"Ledger Reader","scopes":["ledger:read"],"org_ids":["00000000-0000-0000-0000-00000000ce01"]}]
IDENTITY_ADMIN_TOKEN=local-dev-admin-token
# EXECUTION_ADMIN_TOKEN=local-dev-admin-token
# LEDGER_ADMIN_TOKEN=local-dev-admin-token

# Ledger behavior
LEDGER_FAIL_FAST=false

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cex_ai

# Redis
REDIS_URL=redis://127.0.0.1:6379

# NATS
NATS_URL=nats://127.0.0.1:4222

# Matrix bot chain
# MATRIX_HOMESERVER_BASE_URL=http://127.0.0.1:8008
# MATRIX_POLL_HOMESERVER=http://127.0.0.1:8008
# MATRIX_ACCESS_TOKEN=
# MATRIX_BOT_USER_ID=@cex-bot:local.dev
# MATRIX_SYNC_FILTER=
# MATRIX_SYNC_STATE_FILE=/tmp/matrix-bot-poller.state
# MATRIX_TRANSPORT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cex_ai
# MATRIX_RELAY_WORKER_ID=cex-local-relay
# MATRIX_RELAY_INGRESS_TOKEN=replace-with-at-least-32-bytes
# MATRIX_ENTRY_ADAPTER_TOKEN=replace-with-at-least-32-bytes
# MATRIX_ADAPTER_BASE_URL=http://127.0.0.1:8091
# MATRIX_ENTRY_ADAPTER_BASE_URL=http://127.0.0.1:8091
# MATRIX_RECONCILIATION_DATABASE_URL=postgres://matrix_reconciler:replace@localhost:5432/cex_ai
# CONSUMER_ENTRY_INGRESS_TOKEN=
# CONSUMER_ENTRY_REQUIRE_SESSION_AUTH=true
# CONSUMER_ENTRY_SESSION_AUTH_SECRET=replace-me
# Preferred per-issuer form:
# CONSUMER_ENTRY_SESSION_AUTH_ISSUER_SECRETS_JSON={"matrix-entry-adapter":"replace-me"}
# Rotation-friendly form with key IDs:
# CONSUMER_ENTRY_SESSION_AUTH_ISSUER_KEYS_JSON={"matrix-entry-adapter":{"v1":"replace-me"}}
# Shared issuer registry:
# CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_PATH=./run/local-runtime/session-auth-issuer-registry.json
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_PATH=./run/local-runtime/session-auth-issuer-registry.json
# CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_APPROVED_REVISIONS_PATH=./run/local-runtime/session-auth-issuer-registry-approved-revisions.json
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_APPROVED_REVISIONS_PATH=./run/local-runtime/session-auth-issuer-registry-approved-revisions.json
# CONSUMER_ENTRY_SESSION_AUTH_ISSUER_REGISTRY_REQUIRE_APPROVED_REVISION=true
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER_REGISTRY_REQUIRE_APPROVED_REVISION=true
# CONSUMER_ENTRY_SESSION_AUTH_ALLOWED_ISSUERS=matrix-entry-adapter
# CONSUMER_ENTRY_SESSION_AUTH_EXPECTED_AUDIENCE=consumer-entry-api
# MATRIX_ENTRY_INGRESS_TOKEN=
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_SECRET=replace-me
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_KEY_ID=v1
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_ISSUER=matrix-entry-adapter
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_AUDIENCE=consumer-entry-api
# MATRIX_ENTRY_CONSUMER_SESSION_AUTH_TTL_SECS=300

# Operator signal wrapper / notify examples
# OPERATOR_SIGNAL_NOTIFY_ON=warn
# OPERATOR_SIGNAL_NOTIFY_COMMAND=./scripts/notify-operator-signals-example.sh
# OPERATOR_SIGNAL_NOTIFY_POLICY_SUMMARY_LEVEL=short
