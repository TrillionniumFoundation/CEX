[Unit]
Description=CEX persistent TRNM economy consumer API
After=network-online.target cex-trnm-ledger.service
Wants=network-online.target cex-trnm-ledger.service

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/workspace/CEX
ExecStart=%h/.openclaw/workspace/CEX/scripts/run-trnm-economy-service.sh consumer
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
UMask=0077
CPUAccounting=true
CPUWeight=100
CPUQuota=100%
MemoryAccounting=true
ManagedOOMPreference=avoid
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M
IOAccounting=true
IOWeight=100
TasksAccounting=true
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
