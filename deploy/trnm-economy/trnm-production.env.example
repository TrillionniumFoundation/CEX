# TRNM economy production-like launch template.
# Populate every blank value through the runtime secret manager. Do not commit
# populated copies. All credential values must contain at least 32 characters
# and must be pairwise distinct.

APP_ENV=production
CEX_RUNTIME_PROFILE=trnm-economy
CONSUMER_ENTRY_RUNTIME_PROFILE=production

DATABASE_URL=
LEDGER_BASE_URL=http://127.0.0.1:7002
CONSUMER_ENTRY_BIND_ADDR=127.0.0.1:8090

LEDGER_ADMIN_TOKEN=
TRNM_VALUE_ENTITLEMENT_SIGNING_SECRET=
TRNM_GAME_AUTHORITY_TOKEN=
TRNM_PLAYER_SESSION_SIGNING_SECRET=
CONSUMER_ENTRY_INGRESS_TOKEN=
CONSUMER_ENTRY_SESSION_AUTH_SECRET=
CEX_GATEWAY_API_KEY=
CONSUMER_ENTRY_LEAGUE_WEB_SESSION_SECRET=

# Must be an absolute path to a readable, deployment-mounted regular file.
TRNM_ENTITLEMENT_ISSUER_REGISTRY_PATH=/etc/cex/trnm-entitlement-issuer-registry.json

# Legacy floating-point reserve is never available in this runtime profile.
CEX_GATEWAY_LEGACY_RESERVE_BREAK_GLASS=false
