# Execution exact Ledger settlement rollout.
# Keep legacy_v1 until migration 0066 is deployed and P0-N5 transaction separation exists.
CEX_EXECUTION_LEDGER_MODE=legacy_v1

# The adapter uses the existing authenticated internal HTTP client plus a scoped Ledger admin
# token. Do not reuse a human operator token in production.
EXECUTION_LEDGER_SETTLEMENT_ADMIN_TOKEN=REPLACE_EXECUTION_LEDGER_SETTLEMENT_TOKEN
