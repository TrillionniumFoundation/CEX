# CEX Execution exact Ledger settlement worker.
# Replace every secret and URL with values from the target environment.

CEX_RUNTIME_PROFILE=production
APP_ENV=production
DATABASE_URL=postgres://cex_execution_settlement:REPLACE_ME@postgres.internal:5432/cex_ai
LEDGER_BASE_URL=http://ledger-service.internal:7002

# The worker rejects legacy_v1. Prefer require_v2 after the caller cutover is qualified.
CEX_EXECUTION_LEDGER_MODE=dual

# Provide a high-entropy ledger:manage principal. Limit org_ids when deployment is tenant-scoped.
LEDGER_ADMIN_TOKENS_JSON=[{"token":"REPLACE_WITH_HIGH_ENTROPY_LEDGER_MANAGE_TOKEN","actor_id":"execution-settlement-worker","actor_label":"Execution Settlement Worker","scopes":["ledger:manage"]}]

CEX_EXECUTION_SETTLEMENT_WORKER_ID=cex-execution-settlement-prod-1
CEX_EXECUTION_SETTLEMENT_BATCH_SIZE=2
CEX_EXECUTION_SETTLEMENT_LEASE_SECONDS=90
CEX_EXECUTION_SETTLEMENT_REQUEST_TIMEOUT_SECONDS=20
CEX_EXECUTION_SETTLEMENT_POLL_SECONDS=2
CEX_EXECUTION_SETTLEMENT_DATABASE_MAX_CONNECTIONS=4
CEX_EXECUTION_SETTLEMENT_RUN_ONCE=false
RUST_LOG=info
