# CEX -> Trillionnium World remote authority adapter.
# This file is intentionally non-runnable until the token is supplied by a secret manager.

WORLD_AUTHORITY_ADAPTER_RUNTIME_PROFILE=production
WORLD_AUTHORITY_ADAPTER_BIND_ADDR=0.0.0.0:8096
WORLD_AUTHORITY_ADAPTER_TIMEOUT_MS=5000

CEX_WORLD_AUTHORITY_MODE=remote
TRILLIONNIUM_WORLD_BASE_URL=https://world-authority.internal
TRILLIONNIUM_WORLD_API_CONTRACT=trillionnium_world_api_v1
TRILLIONNIUM_WORLD_AUTH_TOKEN=change-me-via-secret-manager-at-least-24-characters

# Truth boundary: source and adapter qualification do not grant production cutover.
TRILLIONNIUM_WORLD_CUTOVER_CONTRACT=trillionnium_world_authority_cutover_v1
TRILLIONNIUM_WORLD_PRODUCTION_AUTHORIZATION=not_granted
