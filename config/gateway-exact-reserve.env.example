# P0-N6 Gateway exact registration and reserve runtime.
# Replace every credential and URL before deployment.

CEX_RUNTIME_PROFILE=production
APP_ENV=production
DATABASE_URL=postgres://cex_gateway_exact:REPLACE_ME@postgres.internal:5432/cex_ai
LEDGER_BASE_URL=http://ledger-service.internal:7002

# Exact mode is explicit. legacy_v1 is rejected by the reserve worker.
CEX_GATEWAY_LEDGER_MODE=dual

# Internal exact-ingress authentication. Production-like profiles require >=32 bytes
# and reject development/placeholder markers.
CEX_GATEWAY_EXACT_INGRESS_TOKEN=REPLACE_WITH_HIGH_ENTROPY_EXACT_INGRESS_TOKEN
CEX_GATEWAY_EXACT_INGRESS_BIND_ADDR=127.0.0.1:7010
CEX_GATEWAY_EXACT_INGRESS_DATABASE_MAX_CONNECTIONS=8

# Remain false throughout schema/command shadow qualification.
CEX_GATEWAY_EXACT_RESERVE_ALLOW_ACTIVE=false

# Provide a high-entropy ledger:manage principal. Limit org_ids for tenant-scoped workers.
LEDGER_ADMIN_TOKENS_JSON=[{"token":"REPLACE_WITH_HIGH_ENTROPY_LEDGER_MANAGE_TOKEN","actor_id":"gateway-exact-reserve-worker","actor_label":"Gateway Exact Reserve Worker","scopes":["ledger:manage"]}]

CEX_GATEWAY_EXACT_RESERVE_WORKER_ID=cex-gateway-exact-reserve-prod-1
CEX_GATEWAY_EXACT_RESERVE_BATCH_SIZE=2
CEX_GATEWAY_EXACT_RESERVE_LEASE_SECONDS=90
CEX_GATEWAY_EXACT_RESERVE_REQUEST_TIMEOUT_SECONDS=20
CEX_GATEWAY_EXACT_RESERVE_POLL_SECONDS=2
CEX_GATEWAY_EXACT_RESERVE_DATABASE_MAX_CONNECTIONS=4
CEX_GATEWAY_EXACT_RESERVE_RUN_ONCE=false
RUST_LOG=info
