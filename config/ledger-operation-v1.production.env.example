# Merge these settings into the secret-managed CEX production environment.
# They apply to the canonical /v2/ledger/effects API.

LEDGER_FAIL_FAST=true
LEDGER_V2_REQUIRE_EXPLICIT_TRACE=true

# Use scoped ledger admin principals. The principal actor_id is persisted as
# source_principal for immutable ledger effects.
LEDGER_ADMIN_TOKENS_JSON=[{"token":"REPLACE_LEDGER_OPERATION_TOKEN","actor_id":"ledger-operation-client","actor_label":"Ledger Operation Client","scopes":["ledger:manage","ledger:read"],"org_ids":["REPLACE_ORG_UUID"]}]
